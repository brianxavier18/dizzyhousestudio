# ===========================================================
# .env.example — Variáveis de ambiente do E3 Chat
# Copie este arquivo para .env e preencha os valores.
# ===========================================================

# --- Evolution API ---
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-chave-aqui
EVOLUTION_INSTANCE_NAME=MinhaInstancia

# --- Webhook (Docker → Host) ---
# Usa o gateway da bridge Docker Compose para o host
WEBHOOK_URL=http://SEU_HOST:5000/webhook
WEBHOOK_PORT=5000
WEBHOOK_SECRET=

# --- Cloudflare Workers AI (Transcrição de Áudio via Whisper) ---
# Após fazer deploy do worker (cd cloudflare-worker && npx wrangler deploy),
# cole a URL gerada aqui. Exemplo:
# CF_WORKER_URL=https://e3chat-audio-transcriber.seu-subdominio.workers.dev
CF_WORKER_URL=
CF_WORKER_AUTH_TOKEN=
CF_TIMEOUT=60

# --- Logging ---
LOG_LEVEL=INFO

# --- Admin (bot NÃO responde a esses números) ---
# Separar múltiplos com vírgula. Formato: DDD+número sem +
ADMIN_NUMBERS=5511999999999
